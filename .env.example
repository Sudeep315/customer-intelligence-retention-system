# Database Configuration
# DB_BACKEND options: auto (try MySQL, fallback to SQLite), mysql, sqlite
DB_BACKEND=auto
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=customer_intelligence_db

# SQLite fallback path (relative to project root)
SQLITE_DB_PATH=data/customer_intelligence.db

# Optional OpenAI API Key for enhanced generative retention playbooks
# Leave empty to use the built-in intelligent rule-and-ML recommendation engine
OPENAI_API_KEY=
